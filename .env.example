# Configuración general del servidor
PORT=3000
NODE_ENV=development

# Base de datos MySQL Community Server 8.4.13
DB_HOST=localhost
DB_PORT=3307
DB_USER=edupeque_app
DB_PASSWORD=cambiar_por_contrasena_segura
DB_NAME=edupeque

# Seguridad y sesiones (generar secreto largo aleatorio)
SESSION_SECRET=cambiar_por_secreto_largo_aleatorio
SESSION_MAX_AGE_MS=28800000

# Origen permitido
CLIENT_ORIGIN=http://localhost:3000
